<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 悬浮球（悬浮窗） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
      常驻前台服务。
      类型是 specialUse|mediaProjection：平时只用 specialUse；
      建立投屏会话时按 Android 14+ 的要求先让前台服务带上 mediaProjection 类型，
      再调用 getMediaProjection（顺序写反会直接抛 SecurityException）。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Android 13+ 前台服务通知需要运行时授权 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- M3 起调用 DeepSeek API 用 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScreenSolve">

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ui.overlay.OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse|mediaProjection">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating_overlay_bubble_for_screen_question_solving" />
        </service>

        <!--
          无界面中转 Activity：MediaProjection 的系统授权框只能由 Activity 发起，
          而悬浮球跑在 Service 里。它只负责拉起授权框并把结果回传给服务，
          所以是全透明、不进最近任务、不留历史。
        -->
        <activity
            android:name=".ui.consent.ConsentActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 选区界面：全屏显示抓到的画面，拖框选题目区域 -->
        <activity
            android:name=".ui.region.RegionSelectActivity"
            android:exported="false"
            android:theme="@style/Theme.ScreenSolve" />

        <activity
            android:name=".ui.history.HistoryActivity"
            android:exported="false"
            android:label="@string/history_title" />

        <!-- 历史 → 会话视图：看图、复制、接着追问 -->
        <activity
            android:name=".ui.history.ConversationActivity"
            android:exported="false"
            android:label="@string/conversation_title"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

    </application>

</manifest>
