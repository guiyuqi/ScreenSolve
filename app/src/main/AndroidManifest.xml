<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 悬浮球（悬浮窗） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
      常驻前台服务。
      类型是 specialUse|mediaProjection：平时只用 specialUse；
      建立投屏会话时按 Android 14+ 的要求先让前台服务带上 mediaProjection 类型，
      再调用 getMediaProjection（顺序写反会直接抛 SecurityException）。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Android 13+ 前台服务通知需要运行时授权 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 拍照模式（应用内自建相机）。只在上面的取景页用到，不涉及相册读写 -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 声明需要相机硬件，但**不**设为 required：没相机的设备也能装，只是拍照模式不可用 -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- M3 起调用 DeepSeek API 用 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".ScreenSolveApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScreenSolve">

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ui.overlay.OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse|mediaProjection">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating_overlay_bubble_for_screen_question_solving" />
        </service>

        <!--
          无界面中转 Activity：MediaProjection 的系统授权框只能由 Activity 发起，
          而悬浮球跑在 Service 里。它只负责拉起授权框并把结果回传给服务，
          所以是全透明、不进最近任务、不留历史。
        -->
        <activity
            android:name=".ui.consent.ConsentActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!--
          拍照模式的中转 Activity：调系统相机、拿回原图，再交给选区界面。
          全透明 + 独立任务栈 + 不入最近任务，用户只会看到"相机 → 框选"。
        -->
        <!--
          注意：这里**不能**加 noHistory。相机盖住本页时，noHistory 会把 Activity 直接结束掉，
          startActivityForResult 的结果就没人接收了（表现为点完快门没反应）。
        -->
        <!--
          取景页是 Activity（相机预览必须有生命周期），所以拍照模式下必然有一次页面切换，
          这是相机本身决定的。但 taskAffinity="" 保证它**不加入搜题助手的任务栈**：
          拍完 finish 后回到用户原来那个 App，答案卡片再以悬浮窗盖上。
          （不加 noHistory：取景页在拍完前不能被系统回收。）
        -->
        <activity
            android:name=".ui.region.PhotoCaptureActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="portrait"
            android:taskAffinity=""
            android:theme="@style/Theme.ScreenSolve" />

        

        <activity
            android:name=".ui.history.HistoryActivity"
            android:exported="false"
            android:label="@string/history_title" />

        <!-- 历史 → 会话视图：看图、复制、接着追问 -->
        <activity
            android:name=".ui.history.ConversationActivity"
            android:exported="false"
            android:label="@string/conversation_title"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

    </application>

</manifest>
